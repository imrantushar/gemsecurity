.DS_Store
node_modules/
.git
**/*.map
assets/build/*.txt

# === Vendor: ignore everything except the runtime dep we ship ===
# /vendor/* (glob the contents) — not /vendor/ — because Git cannot
# un-ignore children of a fully-ignored parent directory, which would
# silently break the `!` negations for newly added vendor files. The
# StoreEngine SDK is committed because WordPress.org installs don't run
# `composer install`.
/vendor/*
!/vendor/storeengine/
!/vendor/composer/
composer.phar

# Editors
.idea
.vscode

# Playwright (local debugging only)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# AI tooling
.claude/
.agents/
openspec/
CLAUDE.md
AGENTS.md
